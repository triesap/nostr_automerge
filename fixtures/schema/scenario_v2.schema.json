{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/fixtures/schema/scenario_v2.schema.json",
  "title": "nostr_automerge signed neutral scenario v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_schema", "fixture_id", "revision", "coordinate", "raw_events", "budget", "cancel_after", "requirements", "expected_report"],
  "properties": {
    "scenario_schema": {"const": "nostr_automerge.signed_scenario.v2"},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{2,127}$"},
    "revision": {"const": "draft_2026_08"},
    "coordinate": {"type": "string", "minLength": 136, "maxLength": 136},
    "raw_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["encoding", "data"],
        "properties": {
          "encoding": {"enum": ["utf8", "base64"]},
          "data": {"type": "string"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "max_items"],
      "properties": {
        "max_bytes": {"type": "integer", "minimum": 0},
        "max_items": {"type": "integer", "minimum": 0}
      }
    },
    "cancel_after": {"type": ["integer", "null"], "minimum": 0},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NCRDT-[A-Z0-9-]+$"}
    },
    "expected_report": {"type": "object"}
  }
}
