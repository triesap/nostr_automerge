{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/fixtures/schema/distribution.schema.v9.json",
  "title": "nostr_automerge signed fixture distribution v9",
  "type": "object",
  "additionalProperties": false,
  "required": ["distribution_schema", "distribution_id", "protocol_revision", "status", "target_fixture_count", "fixture_count", "complete", "base_manifest_sha256", "preserved_v8_fixture_count", "preserved_v8_signed_events_sha256", "missing_v8_fixtures", "missing_v9_fixtures", "intentional_v8_report_changes", "requirements_sha256", "authority_sha256", "companion_sha256", "conformance_sha256", "supersedes", "v9_fixtures", "profiles", "fixtures", "files"],
  "properties": {
    "distribution_schema": {"const": "nostr_automerge.fixture_distribution.v9"},
    "distribution_id": {"const": "draft_2026_08_signed_neutral_9"},
    "protocol_revision": {"const": "draft_2026_08"},
    "status": {"enum": ["locked_transition", "canonical_signed_neutral_corpus"]},
    "target_fixture_count": {"const": 180},
    "fixture_count": {"type": "integer", "minimum": 171, "maximum": 180},
    "complete": {"type": "boolean"},
    "base_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "preserved_v8_fixture_count": {"const": 171},
    "preserved_v8_signed_events_sha256": {"$ref": "#/$defs/sha256"},
    "missing_v8_fixtures": {"type": "array", "maxItems": 0},
    "missing_v9_fixtures": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "intentional_v8_report_changes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "authority_sha256": {"$ref": "#/$defs/sha256"},
    "companion_sha256": {"$ref": "#/$defs/sha256"},
    "conformance_sha256": {"$ref": "#/$defs/sha256"},
    "supersedes": {"const": "fixtures/distribution/manifest_v8.json"},
    "v9_fixtures": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "profiles": {"type": "object"},
    "fixtures": {"type": "array", "minItems": 171, "maxItems": 180},
    "files": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
