{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/fixtures/schema/interop_attestation_v3.schema.json",
  "title": "Opaque independent TypeScript signed-v9 interoperability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "implementation_identity", "commit", "evidence_commit", "dependency_lock_sha256", "fixture_distribution_sha256", "fixture_count", "process_runs", "delivery_permutations", "canonical_output_sha256", "result", "deliberate_mismatch", "provenance"],
  "properties": {
    "schema": {"const": "nostr_automerge.interop_attestation.v3"},
    "implementation_identity": {"const": "triesap/nostr_automerge_typescript"},
    "commit": {"$ref": "#/$defs/commit"},
    "evidence_commit": {"$ref": "#/$defs/commit"},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_distribution_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_count": {"const": 180},
    "process_runs": {"const": 2},
    "delivery_permutations": {"const": 8},
    "canonical_output_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"const": "pass"},
    "deliberate_mismatch": {"const": "detected"},
    "provenance": {"const": "operator-local"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
