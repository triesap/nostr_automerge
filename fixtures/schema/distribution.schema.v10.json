{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/fixtures/schema/distribution.schema.v10.json",
  "title": "nostr_automerge signed fixture distribution v10 transition",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{2,127}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^NCRDT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?:fixtures|spec)/[a-zA-Z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_path",
        "fixture_id",
        "input_paths",
        "metadata_path",
        "profile",
        "requirements"
      ],
      "properties": {
        "expected_path": {
          "$ref": "#/$defs/path"
        },
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "input_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "metadata_path": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "enum": [
            "checkpoint",
            "core",
            "malformed",
            "property",
            "resource"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "required": [
    "distribution_schema",
    "distribution_id",
    "protocol_revision",
    "transition_stage",
    "status",
    "target_fixture_count",
    "fixture_count",
    "complete",
    "base_manifest_sha256",
    "preserved_v9_fixture_count",
    "preserved_v9_signed_events_sha256",
    "missing_v9_fixtures",
    "missing_v10_fixtures",
    "intentional_v9_report_changes",
    "requirements_sha256",
    "authority_sha256",
    "companion_sha256",
    "conformance_sha256",
    "supersedes",
    "v10_fixtures",
    "profiles",
    "fixtures",
    "files"
  ],
  "properties": {
    "distribution_schema": {
      "const": "nostr_automerge.fixture_distribution.v10"
    },
    "distribution_id": {
      "const": "draft_2026_08_signed_neutral_10"
    },
    "protocol_revision": {
      "const": "draft_2026_08"
    },
    "transition_stage": {
      "enum": [
        "distribution_locked",
        "checkpoint_control_fixtures_added",
        "carrier_independence_fixtures_added",
        "interruption_fixtures_added",
        "target_work_fixtures_added",
        "distribution_complete"
      ]
    },
    "status": {
      "enum": [
        "locked_transition",
        "canonical_signed_neutral_corpus"
      ]
    },
    "target_fixture_count": {
      "const": 192
    },
    "fixture_count": {
      "enum": [180, 183, 186, 189, 192]
    },
    "complete": {
      "type": "boolean"
    },
    "base_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preserved_v9_fixture_count": {
      "const": 180
    },
    "preserved_v9_signed_events_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "missing_v9_fixtures": {
      "type": "array",
      "maxItems": 0
    },
    "missing_v10_fixtures": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "intentional_v9_report_changes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "requirements_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "companion_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "conformance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "supersedes": {
      "const": "fixtures/distribution/manifest_v9.json"
    },
    "v10_fixtures": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "core",
        "malformed",
        "property",
        "resource"
      ],
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/profile"
        },
        "core": {
          "$ref": "#/$defs/profile"
        },
        "malformed": {
          "$ref": "#/$defs/profile"
        },
        "property": {
          "$ref": "#/$defs/profile"
        },
        "resource": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 180,
      "maxItems": 192,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  }
}
