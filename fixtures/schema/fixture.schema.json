{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/fixtures/schema/fixture.schema.json",
  "title": "nostr_automerge language-neutral fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_schema",
    "fixture_id",
    "revision",
    "requirements",
    "seed",
    "provenance",
    "inputs",
    "expected"
  ],
  "properties": {
    "fixture_schema": {
      "const": "nostr_automerge.fixture.v1"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{2,127}$"
    },
    "revision": {
      "const": "draft_2026_08"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^NCRDT-[A-Z0-9-]+$"
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "generator_revision",
        "created_at",
        "source_versions"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "generator_revision": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_path",
        "sha256"
      ],
      "properties": {
        "report_path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
