{
  "schema": "nostr_automerge.local_runner_manifest.v2",
  "orchestration": "external_operator",
  "toolchain": {
    "rust": "1.97.1",
    "rust_nightly": "nightly-2026-07-16",
    "cargo_llvm_cov": "0.8.7",
    "cargo_deny": "0.19.8",
    "cargo_fuzz": "0.13.2"
  },
  "jobs": [
    "remediation",
    "policy",
    "standard",
    "conformance",
    "coverage",
    "supply_chain",
    "robustness",
    "resource",
    "release_evidence"
  ],
  "entrypoint": "python3 scripts/local_gate.py",
  "output": {
    "environment": "NOSTR_AUTOMERGE_OUTPUT_ROOT",
    "standalone_default": ".local/evidence"
  }
}
