{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_final_inventory_v19.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "row_contract", "rows", "counts", "candidate_roles", "source_sha256", "catalog_sha256", "self_candidate", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_final_inventory.v19.v1"},
    "status": {"const": "final_source_derived"},
    "authority": {"const": "spec/causal_projection_contracts_v19.json"},
    "row_contract": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "family", "language", "applicability", "source_path", "source_symbol", "site_id", "counter", "owner_mode", "abstract_owner_class", "reachability_sha256", "proof_catalog_id", "proof_trace_sha256", "mutation_coverage_ids", "source_candidate", "catalog_candidate", "result"],
        "properties": {
          "id": {"type": "string"},
          "phase": {"type": "string"},
          "family": {"type": "string"},
          "language": {"const": "rust"},
          "applicability": {"const": "required"},
          "source_path": {"type": "string"},
          "source_symbol": {"type": "string"},
          "site_id": {"type": "string"},
          "counter": {"type": "string"},
          "owner_mode": {"type": "string"},
          "abstract_owner_class": {"type": "string"},
          "reachability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "proof_catalog_id": {"type": "string"},
          "proof_trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mutation_coverage_ids": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
          "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "catalog_candidate": {"const": "266e80b67e13ea377ea874bbd4b75ac4ca5898fa"},
          "result": {"const": "pass"}
        }
      }
    },
    "counts": {"type": "object"},
    "candidate_roles": {"type": "object"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "self_candidate": {"type": "null"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
