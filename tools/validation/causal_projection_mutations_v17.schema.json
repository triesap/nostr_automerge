{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_mutations_v17.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "source_candidate", "mutation_candidate", "input_reports", "mutation_records", "coverage_records", "reverse_coverage", "counts", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_mutations.v17.v1"}, "status": {"const": "actual_complete"},
    "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "mutation_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_reports": {"type": "array", "minItems": 3, "maxItems": 3},
    "mutation_records": {"type": "array", "minItems": 31, "maxItems": 31},
    "coverage_records": {"type": "array", "minItems": 68, "maxItems": 68},
    "reverse_coverage": {"type": "array", "minItems": 31, "maxItems": 31},
    "counts": {"type": "object"}, "result": {"const": "pass"}
  }
}
