{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_evidence_graph_v17.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "final_inventory", "candidate_order", "forward", "reverse_proofs", "reverse_coverage", "counts", "attack_matrix", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_evidence_graph.v17.v1"}, "status": {"const": "final"},
    "final_inventory": {"type": "object"}, "candidate_order": {"type": "array", "minItems": 4, "maxItems": 4},
    "forward": {"type": "array", "minItems": 68, "maxItems": 68},
    "reverse_proofs": {"type": "array", "minItems": 68, "maxItems": 68},
    "reverse_coverage": {"type": "array", "minItems": 68, "maxItems": 68},
    "counts": {"type": "object"}, "attack_matrix": {"type": "array", "minItems": 9, "maxItems": 9},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"const": "pass"}
  }
}
