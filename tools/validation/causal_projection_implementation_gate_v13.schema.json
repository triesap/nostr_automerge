{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/tools/validation/causal_projection_implementation_gate_v13.schema.json",
  "title": "nostr_automerge causal projection implementation gate v13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","rcld","candidate_chain","requirements","projection","work_contract","validators","proof_tests","findings","next_step","holds","result"],
  "properties": {
    "schema": {"const":"nostr_automerge.causal_projection_implementation_gate.v13.v1"},
    "status": {"const":"rcld_117_complete"},
    "rcld": {"const":117},
    "candidate_chain": {"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/candidate"}},
    "requirements": {"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string"}},
    "projection": {
      "type":"object",
      "additionalProperties":false,
      "required":["source","source_sha256","sealed_constructors","operation_families","operation_counts","publication_operations","semantic_consumer_stages","raw_builder_charges","unmetered_production_bypasses"],
      "properties": {
        "source":{"const":"crates/nostr_automerge/src/graph/actor_state.rs"},
        "source_sha256":{"$ref":"#/$defs/sha256"},
        "sealed_constructors":{"const":1},
        "operation_families":{"const":14},
        "operation_counts":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"integer","minimum":0}},
        "publication_operations":{"const":19},
        "semantic_consumer_stages":{"const":3},
        "raw_builder_charges":{"const":0},
        "unmetered_production_bypasses":{"const":0}
      }
    },
    "work_contract": {
      "type":"object",
      "additionalProperties":false,
      "required":["total_charges","graph_node_charges","graph_edge_charges","budget_matrix","cancellation_matrix","first_stop_preserved","zero_post_stop_target_work","reference_oracle_output","signed_fixture_inputs","ample_reports","unexpected_identity"],
      "properties": {
        "total_charges":{"const":72},
        "graph_node_charges":{"const":56},
        "graph_edge_charges":{"const":16},
        "budget_matrix":{"const":"pass"},
        "cancellation_matrix":{"const":"pass"},
        "first_stop_preserved":{"const":true},
        "zero_post_stop_target_work":{"const":true},
        "reference_oracle_output":{"const":"equal"},
        "signed_fixture_inputs":{"const":"immutable"},
        "ample_reports":{"const":"byte_identical"},
        "unexpected_identity":{"const":"preserved"}
      }
    },
    "validators":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/artifact"}},
    "proof_tests":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string"}},
    "findings": {
      "type":"object",
      "additionalProperties":false,
      "required":["open","held"],
      "properties": {
        "open":{"type":"array","minItems":9,"maxItems":9,"uniqueItems":true,"items":{"type":"string"}},
        "held":{"type":"array","minItems":1,"maxItems":1,"items":{"const":"FINDING_080"}}
      }
    },
    "next_step":{"const":"step_1433"},
    "holds":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"type":"string"}},
    "result":{"const":"pass"}
  },
  "$defs": {
    "candidate": {
      "type":"object",
      "additionalProperties":false,
      "required":["step","candidate"],
      "properties": {
        "step":{"type":"string","pattern":"^step_[0-9]{4}$"},
        "candidate":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    },
    "artifact": {
      "type":"object",
      "additionalProperties":false,
      "required":["path","sha256"],
      "properties": {
        "path":{"type":"string","minLength":1},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
