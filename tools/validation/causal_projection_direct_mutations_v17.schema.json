{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_direct_mutations_v17.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "base_candidate", "campaign", "rows", "counts", "worktree", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_direct_mutations.v17.v1"},
    "status": {"const": "actual_execution"}, "base_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "campaign": {"const": "every_actor_and_causal_direct_site"},
    "rows": {"type": "array", "minItems": 11, "maxItems": 11},
    "counts": {"type": "object"}, "worktree": {"type": "object"}, "result": {"const": "pass"}
  }
}
