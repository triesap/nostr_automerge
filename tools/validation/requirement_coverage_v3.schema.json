{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/tools/validation/requirement_coverage_v3.schema.json",
  "title": "Executed normative requirement evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirements_sha256", "applicability_sha256", "fixture_distribution_sha256", "requirement_count", "rows"],
  "properties": {
    "schema": {"const": "nostr_automerge.requirement_coverage.v3"},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "applicability_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_distribution_sha256": {"$ref": "#/$defs/sha256"},
    "requirement_count": {"type": "integer", "const": 87},
    "rows": {"type": "array", "minItems": 87, "maxItems": 87, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "section", "text_sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "implementation_identity", "implementation_commit", "implementation_path", "evidence_kind", "evidence_id", "execution_command", "runner_job", "result_artifact", "result_sha256", "result"],
      "properties": {
        "language": {"enum": ["rust", "typescript"]},
        "implementation_identity": {"enum": ["triesap/nostr_automerge", "triesap/nostr_automerge_typescript"]},
        "implementation_commit": {"$ref": "#/$defs/commit"},
        "implementation_path": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["cargo_test", "signed_fixture", "policy"]},
        "evidence_id": {"type": "string", "minLength": 1},
        "execution_command": {"type": "string", "minLength": 1},
        "runner_job": {"type": "string", "minLength": 1},
        "result_artifact": {"type": "string", "minLength": 1},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"const": "pass"}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "applicability", "authority", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^NCRDT-[A-Z0-9-]+$"},
        "applicability": {"enum": ["rust-and-typescript", "rust-only", "out-of-core", "explicitly-deferred"]},
        "authority": {"$ref": "#/$defs/authority"},
        "status": {"enum": ["pass", "held", "not-applicable"]},
        "proofs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proof"}},
        "rationale": {"type": "string", "minLength": 1},
        "hold": {"type": "string", "minLength": 1}
      }
    }
  }
}
