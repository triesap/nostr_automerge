{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nostr-automerge.example/schema/persistent_state_integration_v11.schema.json",
  "title": "nostr_automerge persistent state integration v11 gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "stage",
    "revision",
    "core_gate_sha256",
    "candidates",
    "call_sites",
    "source_inventory",
    "source_projection_sha256",
    "tests",
    "counts",
    "properties",
    "result"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.persistent_state_integration.v11.v1" },
    "status": { "const": "pass" },
    "stage": { "const": "rust_persistent_state_integration" },
    "revision": { "const": "draft_2026_08" },
    "core_gate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "candidate"],
        "properties": {
          "step": { "type": "string" },
          "candidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "call_sites": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "boundary", "owner"],
        "properties": {
          "name": { "type": "string" },
          "boundary": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "source_inventory": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_projection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tests": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "call_site_count",
        "source_file_count",
        "enabled_test_count",
        "deep_chain_nodes",
        "source_policy_mutations",
        "integration_controls",
        "integration_changes"
      ],
      "properties": {
        "candidate_count": { "const": 5 },
        "call_site_count": { "const": 8 },
        "source_file_count": { "const": 7 },
        "enabled_test_count": { "const": 6 },
        "deep_chain_nodes": { "const": 64 },
        "source_policy_mutations": { "const": 21 },
        "integration_controls": { "const": 2 },
        "integration_changes": { "const": 2 }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer_item_read_before_charge",
        "persistent_node_read_before_charge",
        "failed_extension_publishes_state",
        "typed_stop_preserved",
        "n_minus_one_no_progress",
        "n_and_n_plus_one_compatible",
        "every_observed_boundary_cancellable",
        "runtime_unmetered_bypass"
      ],
      "properties": {
        "outer_item_read_before_charge": { "const": false },
        "persistent_node_read_before_charge": { "const": false },
        "failed_extension_publishes_state": { "const": false },
        "typed_stop_preserved": { "const": true },
        "n_minus_one_no_progress": { "const": true },
        "n_and_n_plus_one_compatible": { "const": true },
        "every_observed_boundary_cancellable": { "const": true },
        "runtime_unmetered_bypass": { "const": false }
      }
    },
    "result": { "const": "pass" }
  }
}
