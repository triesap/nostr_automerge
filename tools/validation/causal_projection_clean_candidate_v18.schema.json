    "observation": {"type": "object", "additionalProperties": false, "required": ["command", "output_sha256", "tracked_changes", "staged_changes", "untracked_paths", "terminal_commit_path_count", "result"], "properties": {"command": {"const": "git status --porcelain=v1"}, "output_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}, "tracked_changes": {"const": 0}, "staged_changes": {"const": 0}, "untracked_paths": {"const": 0}, "terminal_commit_path_count": {"const": 15}, "result": {"const": "clean"}}},
