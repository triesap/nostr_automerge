    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["policy", "terminal_artifact_commit", "attestation_relationship", "self_reference", "terminal_artifacts_mutated"], "properties": {"policy": {"const": "acyclic_later_attestation"}, "terminal_artifact_commit": {"const": "13083650829207c12e1fcd719251159816ab6833"}, "attestation_relationship": {"const": "strict_descendant"}, "self_reference": {"const": false}, "terminal_artifacts_mutated": {"const": false}}}
