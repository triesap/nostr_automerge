          "candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "status": {"const": "enabled_pass"}
        },
        "additionalProperties": false
      }
    },
    "finding_proofs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
