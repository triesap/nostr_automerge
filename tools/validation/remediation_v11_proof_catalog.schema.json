          "family": {"type": "string"},
          "mode": {"enum": ["item_metered", "exact_reservation", "constant_time"]},
          "owner": {"type": "string"},
          "boundary": {"type": "string"},
          "proof_id": {"type": "string", "pattern": "^V11-(RESOURCE|STOP)-[0-9]{3}$"}
        },
        "additionalProperties": false
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 24,
