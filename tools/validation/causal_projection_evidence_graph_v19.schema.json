{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_evidence_graph_v19.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "candidate_roles", "final_inventory", "catalog", "process_evidence", "candidate_order", "forward", "reverse_proofs", "reverse_mutations", "counts", "attack_matrix", "self_candidate", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_evidence_graph.v19.v1"},
    "status": {"const": "final_bidirectional"},
    "authority": {"const": "spec/causal_projection_contracts_v19.json"},
    "candidate_roles": {"type": "object"},
    "final_inventory": {"type": "object"},
    "catalog": {"type": "object"},
    "process_evidence": {"type": "object"},
    "candidate_order": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "forward": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["inventory_row_id", "proof_catalog_id", "mutation_coverage_ids", "result"],
        "properties": {
          "inventory_row_id": {"type": "string"},
          "proof_catalog_id": {"type": "string"},
          "mutation_coverage_ids": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
          "result": {"const": "pass"}
        }
      }
    },
    "reverse_proofs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["proof_catalog_id", "inventory_row_ids", "result"],
        "properties": {
          "proof_catalog_id": {"type": "string"},
          "inventory_row_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result": {"const": "pass"}
        }
      }
    },
    "reverse_mutations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mutation_catalog_id", "inventory_row_ids", "result"],
        "properties": {
          "mutation_catalog_id": {"type": "string"},
          "inventory_row_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result": {"const": "pass"}
        }
      }
    },
    "counts": {"type": "object"},
    "attack_matrix": {"type": "array", "minItems": 1},
    "self_candidate": {"type": "null"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
