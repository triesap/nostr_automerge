{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nostr-automerge.example/schema/causal-projection-operation-contract-v13.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","status","requirements","charge_rule","families","source_boundaries","prohibited_patterns","final_operation_count","result"],
  "properties":{
    "schema":{"const":"nostr_automerge.causal_projection_operation_contract.v13.v1"},
    "status":{"enum":["approved_discovery_complete","implementation_complete"]},
    "requirements":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true},
    "charge_rule":{"const":"charge_then_operation_then_observation"},
    "families":{"type":"array","minItems":14,"maxItems":14},
    "source_boundaries":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true},
    "prohibited_patterns":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true},
    "final_operation_count":{"type":["integer","null"],"minimum":1},
    "result":{"const":"pass"}
  }
}
