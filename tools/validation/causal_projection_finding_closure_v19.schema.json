{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","rcld","base_candidate","imports","findings","held_findings","counts","release_claimed","publication_claimed","remote_actions","result","result_identity_sha256"],
  "properties": {
    "schema": {"const":"nostr_automerge.causal_projection_finding_closure.v19.v1"},
    "status": {"const":"verified"},
    "rcld": {"const":146},
    "base_candidate": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "imports": {"type":"object"},
    "findings": {"type":"array","minItems":4,"maxItems":4},
    "held_findings": {"const":["FINDING_080"]},
    "counts": {"type":"object"},
    "release_claimed": {"const":false},
    "publication_claimed": {"const":false},
    "remote_actions": {"const":0},
    "result": {"const":"pass"},
    "result_identity_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
