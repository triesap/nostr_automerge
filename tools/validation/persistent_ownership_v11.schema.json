{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nostr-automerge.example/schema/persistent_ownership_v11.schema.json",
  "title": "nostr_automerge bounded persistent ownership v11 gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "stage",
    "revision",
    "requirement",
    "candidates",
    "structures",
    "source_inventory",
    "source_projection_sha256",
    "tests",
    "counts",
    "properties",
    "result"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.persistent_ownership.v11.v1" },
    "status": { "const": "pass" },
    "stage": { "const": "rust_bounded_persistent_teardown" },
    "revision": { "const": "draft_2026_08" },
    "requirement": { "const": "NCRDT-OWNERSHIP-001" },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "candidate"],
        "properties": {
          "step": { "type": "string", "pattern": "^step_133[5-8]$" },
          "candidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "structures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unique_teardown", "shared_teardown"],
        "properties": {
          "name": { "enum": ["persistent_delta_map", "control_ancestry"] },
          "unique_teardown": { "const": "iterative_arc_try_unwrap" },
          "shared_teardown": { "const": "stop_at_first_shared_parent" }
        }
      }
    },
    "source_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_projection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tests": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_count",
        "source_file_count",
        "enabled_test_count",
        "constrained_stack_bytes",
        "delta_unique_depth",
        "ancestry_unique_depth",
        "delta_wide_forks",
        "ancestry_wide_forks"
      ],
      "properties": {
        "structure_count": { "const": 2 },
        "source_file_count": { "const": 2 },
        "enabled_test_count": { "const": 8 },
        "constrained_stack_bytes": { "const": 65536 },
        "delta_unique_depth": { "const": 100000 },
        "ancestry_unique_depth": { "const": 20000 },
        "delta_wide_forks": { "const": 10000 },
        "ancestry_wide_forks": { "const": 4096 }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_chain_stack_bounded",
        "shared_parent_mutated",
        "shared_parent_recursive_drop",
        "value_double_drop",
        "unpublished_value_leak",
        "post_stop_semantic_traversal",
        "unexpected_panic_masked"
      ],
      "properties": {
        "unique_chain_stack_bounded": { "const": true },
        "shared_parent_mutated": { "const": false },
        "shared_parent_recursive_drop": { "const": false },
        "value_double_drop": { "const": false },
        "unpublished_value_leak": { "const": false },
        "post_stop_semantic_traversal": { "const": false },
        "unexpected_panic_masked": { "const": false }
      }
    },
    "result": { "const": "pass" }
  }
}
