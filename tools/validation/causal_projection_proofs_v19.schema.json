{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_proofs_v19.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "source_candidate", "execution_base_candidate", "inventory_path", "inventory_sha256", "row_contract", "rows", "counts", "execution", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_proofs.v19.v1"},
    "status": {"const": "actual_execution_raw_unbound"},
    "authority": {"const": "spec/causal_projection_contracts_v19.json"},
    "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_base_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inventory_path": {"const": "reports/causal_projection_inventory_v19.json"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_contract": {"type": "array", "uniqueItems": true},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["proof_row_id", "inventory_row_id", "site_id", "phase", "family", "counter", "command", "trace_artifact", "trace_sha256", "stdout_sha256", "stderr_sha256", "raw_stdout_sha256", "raw_stderr_sha256", "source_candidate", "execution_base_candidate", "result"]}},
    "counts": {"type": "object"},
    "execution": {"type": "object"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
