{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "checkpoint",
    "candidate",
    "imports",
    "finding_registry_sha256",
    "reproduction_catalog_sha256",
    "findings",
    "counts",
    "holds",
    "release_claimed",
    "remote_actions",
    "result",
    "result_identity_sha256"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.remediation_v12_finding_closure.v1" },
    "status": { "const": "code_complete_publication_held" },
    "checkpoint": { "const": "step_1418" },
    "candidate": { "$ref": "#/$defs/commit" },
    "imports": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "sha256"],
        "properties": {
          "category": { "type": "string" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "finding_registry_sha256": { "$ref": "#/$defs/hash" },
    "reproduction_catalog_sha256": { "$ref": "#/$defs/hash" },
    "findings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["closed", "held"] },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "closed", "held", "open"],
      "properties": {
        "findings": { "const": 5 },
        "closed": { "const": 4 },
        "held": { "const": 1 },
        "open": { "const": 0 }
      }
    },
    "holds": {
      "const": [
        "external_assurance",
        "event_kind_allocation",
        "nip_submission",
        "production_qualification",
        "publication",
        "release",
        "remote_mutation"
      ]
    },
    "release_claimed": { "const": false },
    "remote_actions": { "const": 0 },
    "result": { "const": "pass" },
    "result_identity_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
