{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/triesap/nostr_automerge/spec/requirements.schema.json",
  "title": "nostr_automerge normative requirements registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "requirement_count", "requirements"],
  "properties": {
    "schema": {"const": "nostr_automerge.requirements.v6"},
    "project": {"const": "nostr_automerge_v1_spec"},
    "requirement_count": {"enum": [139, 148, 152, 156]},
    "requirements": {
      "type": "array",
      "minItems": 139,
      "maxItems": 156,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section", "text", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^NCRDT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
          "section": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "^(spec|implementation)/[A-Za-z0-9_./-]+$"}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "requirement_count": {"const": 139},
        "requirements": {"minItems": 139, "maxItems": 139}
      }
    },
    {
      "properties": {
        "requirement_count": {"const": 148},
        "requirements": {"minItems": 148, "maxItems": 148}
      }
    },
    {
      "properties": {
        "requirement_count": {"const": 152},
        "requirements": {"minItems": 152, "maxItems": 152}
      }
    },
    {
      "properties": {
        "requirement_count": {"const": 156},
        "requirements": {"minItems": 156, "maxItems": 156}
      }
    }
  ]
}
