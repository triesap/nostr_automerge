    "status": {"const": "actual_zero_change"},
    "evidence_graph": {"type": "object"},
    "release_boundary": {"type": "object"},
    "execution_base": {"type": "object"},
    "prior_transition": {"type": "object"},
    "selected_manifest": {"type": "object"},
    "selected_lock": {"type": "object"},
    "actual_runs": {"type": "array", "minItems": 2, "maxItems": 2},
    "affected_fixture_ids": {"type": "array", "maxItems": 0},
    "counts": {"type": "object"},
    "identity": {"type": "object"},
    "derivation": {"type": "object"},
    "result": {"const": "pass"}
