{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_catalogs_v19.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "candidate_roles", "proof_catalog", "mutation_catalog", "candidate_order", "counts", "binding", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_catalogs.v19.v1"},
    "status": {"const": "committed_later_binding"},
    "authority": {"const": "spec/causal_projection_contracts_v19.json"},
    "candidate_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate", "proof_execution_base", "proof_artifact_commit", "mutation_execution_base", "mutation_artifact_commit"],
      "properties": {
        "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "proof_execution_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "proof_artifact_commit": {"const": "7c5a1603c4ee9f92d541a8ff6fd66071806518df"},
        "mutation_execution_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "mutation_artifact_commit": {"const": "001bea9cb5edc8fb83aa972901f749f4707d59e1"}
      }
    },
    "proof_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "artifact_commit", "rows", "result"],
      "properties": {
        "report_path": {"const": "reports/causal_projection_proofs_v19.json"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_commit": {"const": "7c5a1603c4ee9f92d541a8ff6fd66071806518df"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "inventory_row_id", "trace_artifact", "trace_sha256", "artifact_commit", "result"],
            "properties": {
              "id": {"type": "string"},
              "inventory_row_id": {"type": "string"},
              "trace_artifact": {"type": "string"},
              "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifact_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "result": {"const": "pass"}
            }
          }
        },
        "result": {"const": "pass"}
      }
    },
    "mutation_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "artifact_commit", "rows", "result"],
      "properties": {
        "report_path": {"const": "reports/causal_projection_mutations_v19.json"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_commit": {"const": "001bea9cb5edc8fb83aa972901f749f4707d59e1"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "campaign", "inventory_row_id", "helper", "kind", "patch_artifact", "patch_sha256", "transcript_artifact", "transcript_sha256", "artifact_commit", "result"],
            "properties": {
              "id": {"type": "string"},
              "campaign": {"enum": ["helper", "direct", "provenance"]},
              "inventory_row_id": {"type": "string"},
              "helper": {"type": ["string", "null"]},
              "kind": {"type": "string"},
              "patch_artifact": {"type": "string"},
              "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "transcript_artifact": {"type": "string"},
              "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifact_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "result": {"const": "killed"}
            }
          }
        },
        "result": {"const": "pass"}
      }
    },
    "candidate_order": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "counts": {"type": "object"},
    "binding": {"type": "object"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
