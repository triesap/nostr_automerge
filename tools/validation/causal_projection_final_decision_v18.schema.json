{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_final_decision_v18.schema.json",
  "title": "nostr_automerge causal projection final decision v18",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "rcld", "candidate", "imports", "decision", "gates", "holds", "release_claimed", "publication_claimed", "remote_actions", "result", "result_identity_sha256"],
  "properties": {
    "schema": { "const": "nostr_automerge.causal_projection_final_decision.v18.v1" },
    "status": { "const": "code_complete_publication_held" },
    "rcld": { "const": 140 },
    "candidate": { "$ref": "#/$defs/commit" },
    "imports": { "$ref": "#/$defs/hashObject" },
    "decision": { "type": "object" },
    "gates": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "type": "object" } },
    "holds": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "release_claimed": { "const": false },
    "publication_claimed": { "const": false },
    "remote_actions": { "const": 0 },
    "result": { "const": "pass" },
    "result_identity_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hashObject": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } }
  }
}
