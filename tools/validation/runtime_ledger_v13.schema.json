{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nostr-automerge.example/schema/runtime-ledger-v13.json",
  "title": "nostr_automerge runtime ledger v13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","authority","cursor","findings","active_checkpoint_scope","predecessors"],
  "properties": {
    "schema": {"const":"nostr_automerge.runtime_ledger.v13.v1"},
    "status": {"enum":["correction_active","code_complete_publication_held"]},
    "authority": {"const":"spec/remediation_v13_authority.json"},
    "cursor": {
      "type":"object",
      "additionalProperties":false,
      "required":["active_rcld","active_step","next_step","last_planned_step","remaining_checkpoint_count","remaining_rcld_count"]
    },
    "findings": {
      "type":"object",
      "additionalProperties":false,
      "required":["open","held"]
    },
    "active_checkpoint_scope": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "predecessors": {"type":"array","items":{"type":"object"}}
  }
}
