{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/opaque_causal_projection_v19.schema.json",
  "title": "nostr_automerge opaque causal projection v19 assurance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate_roles",
    "public_candidates",
    "evidence_sha256",
    "distribution_sha256",
    "counts",
    "applicability_classes",
    "result_classes",
    "canonical_output_sha256",
    "serialized_run_sha256",
    "clean_target_scope",
    "independent_implementation",
    "public_api_changed",
    "protocol_changed",
    "release_claimed",
    "publication_claimed",
    "remote_actions",
    "result",
    "identity_sha256"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.opaque_causal_projection.v19.v1" },
    "status": { "const": "code_complete_publication_held" },
    "candidate_roles": { "$ref": "#/$defs/candidates" },
    "public_candidates": { "$ref": "#/$defs/candidates" },
    "evidence_sha256": { "$ref": "#/$defs/hashes" },
    "distribution_sha256": { "$ref": "#/$defs/hashes" },
    "counts": { "type": "object" },
    "applicability_classes": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "result_classes": { "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": { "type": "string" } },
    "canonical_output_sha256": { "$ref": "#/$defs/hash" },
    "serialized_run_sha256": { "$ref": "#/$defs/hash" },
    "clean_target_scope": { "const": true },
    "independent_implementation": { "const": true },
    "public_api_changed": { "const": false },
    "protocol_changed": { "const": false },
    "release_claimed": { "const": false },
    "publication_claimed": { "const": false },
    "remote_actions": { "const": 0 },
    "result": { "const": "pass" },
    "identity_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/commit" } },
    "hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }
  }
}
