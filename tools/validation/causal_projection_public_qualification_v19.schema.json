    "distribution_transition": {"type": "object"},
    "execution_base": {"type": "object"},
    "repetitions": {"type": "array", "minItems": 2, "maxItems": 2},
    "aggregate": {"type": "object"},
    "frozen": {"type": "object"},
    "holds": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true},
