{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nostr-automerge.example/schema/remediation-v13-evidence-policy.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","status","authority","policy","requirements","owner_modes","required_row_fields","approved_roots","opaque_allowed_fields","opaque_prohibited_fields","result"],
  "properties": {
    "schema":{"const":"nostr_automerge.remediation_v13_evidence_policy.v1"},
    "status":{"const":"approved_active"},
    "authority":{"const":"spec/remediation_v13_authority.json"},
    "policy":{"type":"object","additionalProperties":false,"required":["path","sha256"]},
    "requirements":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true},
    "owner_modes":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true},
    "required_row_fields":{"type":"array","minItems":11,"maxItems":11,"uniqueItems":true},
    "approved_roots":{"type":"array","uniqueItems":true},
    "opaque_allowed_fields":{"type":"array","uniqueItems":true},
    "opaque_prohibited_fields":{"type":"array","uniqueItems":true},
    "result":{"const":"pass"}
  }
}
