{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_inventory_v19.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "source_candidate", "source_path", "source_production_sha256", "row_contract", "rows", "counts", "derivation", "proof_event_model", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_inventory.v19.v1"},
    "status": {"const": "provisional_source_derived"},
    "authority": {"const": "spec/causal_projection_contracts_v19.json"},
    "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_path": {"const": "crates/nostr_automerge/src/graph/actor_state.rs"},
    "source_production_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_contract": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "site_id", "family", "language", "applicability", "source_path", "source_symbol", "owner_mode", "counter", "abstract_owner_class", "reachability_sha256", "proof_test", "proof_command", "proof_status", "source_candidate", "result"]
      }
    },
    "counts": {"type": "object"},
    "derivation": {"type": "object"},
    "proof_event_model": {"type": "object"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
