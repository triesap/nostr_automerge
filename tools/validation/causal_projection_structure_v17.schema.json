{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_structure_v17.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "mode", "source_path", "site_count", "helper_checks", "consumer_checks", "mutation_matrix", "neutral_comment", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_structure.v17.v1"},
    "status": {"const": "structural_only"}, "mode": {"const": "structural"},
    "source_path": {"type": "string"}, "site_count": {"const": 68},
    "helper_checks": {"type": "array", "minItems": 6, "maxItems": 6},
    "consumer_checks": {"type": "array", "minItems": 2, "maxItems": 2},
    "mutation_matrix": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mutation", "expected_code", "actual_code", "result"],
        "properties": {"mutation": {"type": "string"}, "expected_code": {"type": "string"}, "actual_code": {"type": "string"}, "result": {"const": "killed"}}
      }
    },
    "neutral_comment": {"const": "pass"}, "result": {"const": "pass"}
  }
}
