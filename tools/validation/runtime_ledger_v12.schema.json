{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nostr-automerge.example/schema/runtime-ledger-v12.json",
  "title": "nostr_automerge runtime ledger v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "authority",
    "cursor",
    "findings",
    "requirements",
    "active_checkpoint_scope",
    "predecessors"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.runtime_ledger.v12.v1" },
    "status": { "enum": ["implementation_in_progress", "code_complete_publication_held"] },
    "authority": { "const": "spec/remediation_v12_authority.json" },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_rcld", "active_step", "next_step", "last_planned_step", "remaining_checkpoint_count", "remaining_rcld_count"],
      "properties": {
        "active_rcld": { "type": "integer", "minimum": 109, "maximum": 115 },
        "active_step": { "type": "string", "pattern": "^step_[0-9]{4}$" },
        "next_step": { "type": ["string", "null"], "pattern": "^step_[0-9]{4}$" },
        "last_planned_step": { "const": "step_1419" },
        "remaining_checkpoint_count": { "type": "integer", "minimum": 0, "maximum": 55 },
        "remaining_rcld_count": { "type": "integer", "minimum": 0, "maximum": 7 }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "held"],
      "properties": {
        "open": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "held": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "active_checkpoint_scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "candidate", "owner_class", "result"],
        "properties": {
          "step": { "type": "string" },
          "candidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "owner_class": { "enum": ["public", "opaque_compatibility"] },
          "result": { "const": "pass" }
        }
      }
    }
  }
}
