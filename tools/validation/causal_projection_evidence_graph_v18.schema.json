{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triesap.github.io/nostr-automerge/schemas/causal_projection_evidence_graph_v18.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "final_inventory", "catalog", "candidate_order", "forward", "reverse_proofs", "reverse_mutations", "counts", "attack_matrix", "self_candidate", "result_identity_sha256", "result"],
  "properties": {
    "schema": {"const": "nostr_automerge.causal_projection_evidence_graph.v18.v1"},
    "status": {"const": "final_bidirectional"},
    "authority": {"const": "spec/causal_projection_contracts_v18.json"},
    "final_inventory": {"type": "object", "additionalProperties": false, "required": ["path", "candidate", "sha256"], "properties": {"path": {"type": "string"}, "candidate": {"type": "string"}, "sha256": {"type": "string"}}},
    "catalog": {"type": "object", "additionalProperties": false, "required": ["path", "candidate", "sha256"], "properties": {"path": {"type": "string"}, "candidate": {"type": "string"}, "sha256": {"type": "string"}}},
    "candidate_order": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
    "forward": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["inventory_row_id", "proof_catalog_id", "mutation_coverage_ids", "result"], "properties": {"inventory_row_id": {"type": "string"}, "proof_catalog_id": {"type": "string"}, "mutation_coverage_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "result": {"const": "pass"}}}},
    "reverse_proofs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["proof_catalog_id", "inventory_row_ids", "result"], "properties": {"proof_catalog_id": {"type": "string"}, "inventory_row_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "result": {"const": "pass"}}}},
    "reverse_mutations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["mutation_catalog_id", "inventory_row_ids", "result"], "properties": {"mutation_catalog_id": {"type": "string"}, "inventory_row_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "result": {"const": "pass"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["inventory_rows", "proof_edges", "mutation_edges", "proof_catalog_rows", "mutation_catalog_rows", "dangling", "extra"]},
    "attack_matrix": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["attack", "result"]}},
    "self_candidate": {"type": "null"},
    "result_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "pass"}
  }
}
