    "commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_binding": {"type":"object","additionalProperties":false,"required":["role","path","sha256"],"properties":{"role":{"enum":["actor","control","consumer"]},"path":{"type":"string"},"sha256":{"$ref":"#/$defs/hash"}}},
