    "conformance": {"type":"object","additionalProperties":false,"required":["manifest","canonical_process_bytes","canonical_output_sha256","serialized_run_sha256"],"properties":{"manifest":{"const":"fixtures/distribution/manifest_v15.json"},"canonical_process_bytes":{"const":"identical"},"canonical_output_sha256":{"$ref":"#/$defs/hash"},"serialized_run_sha256":{"$ref":"#/$defs/hash"}}},
    "assurance": {"type":"object","additionalProperties":false,"required":["inventory","proofs","structure","identity","mutations","consumers","dependency_count_counter","applicability"],"properties":{"inventory":{"const":"complete"},"proofs":{"const":"complete"},"structure":{"const":"complete"},"identity":{"const":"complete"},"mutations":{"const":"zero_survivors"},"consumers":{"const":"closed"},"dependency_count_counter":{"const":"GraphNode"},"applicability":{"const":"source_derived"}}}
