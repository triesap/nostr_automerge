    "phases": {"type":"object","additionalProperties":false,"required":["projection_construction","actor_sequence","causal_counter_consumer","frontier_comparison"],"properties":{"projection_construction":{"const":50},"actor_sequence":{"const":4},"causal_counter_consumer":{"const":3},"frontier_comparison":{"const":11}}},
