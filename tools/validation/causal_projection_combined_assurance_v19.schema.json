{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","rcld","base_candidate","imports","candidate_roles","counts","applicability","identities","finding_closure","result_classes","canonical_process_bytes","public_api_changed","protocol_changed","release_claimed","publication_claimed","remote_actions","result","result_identity_sha256"],
  "properties": {
    "schema": {"const":"nostr_automerge.causal_projection_combined_assurance.v19.v1"},
    "status": {"const":"verified"},
    "rcld": {"const":146},
    "base_candidate": {"$ref":"#/$defs/commit"},
    "imports": {"type":"object"},
    "candidate_roles": {"type":"object"},
    "counts": {"type":"object"},
    "applicability": {"type":"object"},
    "identities": {"type":"object"},
    "finding_closure": {"type":"array","minItems":4,"maxItems":4},
    "result_classes": {"type":"array","minItems":8,"maxItems":8},
    "canonical_process_bytes": {"const":"identical"},
    "public_api_changed": {"const":false},
    "protocol_changed": {"const":false},
    "release_claimed": {"const":false},
    "publication_claimed": {"const":false},
    "remote_actions": {"const":0},
    "result": {"const":"pass"},
    "result_identity_sha256": {"$ref":"#/$defs/hash"}
  },
  "$defs": {
    "commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "hash": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
