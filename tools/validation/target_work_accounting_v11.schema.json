{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nostr-automerge.example/schema/target_work_accounting_v11.schema.json",
  "title": "nostr_automerge target work accounting v11 gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "stage",
    "revision",
    "imported_gates",
    "candidates",
    "operations",
    "source_inventory",
    "source_projection_sha256",
    "tests",
    "counts",
    "properties",
    "result"
  ],
  "properties": {
    "schema": { "const": "nostr_automerge.target_work_accounting.v11.v1" },
    "status": { "const": "pass" },
    "stage": { "const": "rust_complete_target_work_accounting" },
    "revision": { "const": "draft_2026_08" },
    "imported_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistent_core_sha256", "persistent_integration_sha256"],
      "properties": {
        "persistent_core_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "persistent_integration_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "candidate"],
        "properties": {
          "step": { "type": "string" },
          "candidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "mode", "owner", "boundary", "proof"],
        "properties": {
          "family": { "type": "string" },
          "mode": { "enum": ["item_metered", "exact_reservation", "constant_time"] },
          "owner": { "type": "string" },
          "boundary": { "type": "string" },
          "proof": { "type": "string" }
        }
      }
    },
    "source_inventory": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_projection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tests": { "type": "array", "minItems": 17, "maxItems": 17, "items": { "type": "string" } },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "operation_family_count", "source_file_count", "enabled_test_count", "source_policy_mutations", "fixed_reproduction_count", "open_reproduction_count"],
      "properties": {
        "candidate_count": { "const": 7 },
        "operation_family_count": { "const": 15 },
        "source_file_count": { "const": 15 },
        "enabled_test_count": { "const": 17 },
        "source_policy_mutations": { "const": 63 },
        "fixed_reproduction_count": { "const": 2 },
        "open_reproduction_count": { "const": 2 }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["every_proportional_operation_classified", "every_live_target_operation_item_metered", "sealed_reservation_broadened", "post_stop_observations", "typed_stop_preserved", "canonical_no_progress_only", "ample_capacity_reports_compatible", "bounded_teardown_qualified"],
      "properties": {
        "every_proportional_operation_classified": { "const": true },
        "every_live_target_operation_item_metered": { "const": true },
        "sealed_reservation_broadened": { "const": false },
        "post_stop_observations": { "const": 0 },
        "typed_stop_preserved": { "const": true },
        "canonical_no_progress_only": { "const": true },
        "ample_capacity_reports_compatible": { "const": true },
        "bounded_teardown_qualified": { "const": false }
      }
    },
    "result": { "const": "pass" }
  }
}
